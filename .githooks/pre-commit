#!/bin/sh
# Formats staged files with prettier before commit.
# Wired up by `pnpm install` via the "prepare" script (core.hooksPath).
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.json' '*.css' '*.html' '*.md')
if [ -n "$staged" ]; then
  echo "$staged" | xargs pnpm exec prettier --write
  echo "$staged" | xargs git add
fi

# CROSS_REPO_SYNC(pre-commit-sync-warning)
# A warning only: the sibling may be mid-port. The release preflight blocks.
node scripts/sync-check.mjs --quiet || echo "pre-commit: shared regions differ from the sibling repo (docs/CROSS_REPO_SYNC.md)"
# CROSS_REPO_SYNC_END(pre-commit-sync-warning)
