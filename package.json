{
  "name": "bender",
  "private": true,
  "version": "0.15.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "ab": "tsx scripts/ab.ts",
    "bench": "tsx scripts/bench.ts",
    "blocks": "tsx scripts/blocks.ts",
    "cold": "tsx scripts/cold.ts",
    "diagram": "tsx scripts/chain-svg.ts",
    "features": "tsx scripts/features.ts",
    "figure": "tsx scripts/figure.ts",
    "knife": "tsx scripts/knife.ts",
    "soak": "tsx scripts/soak.ts",
    "preview": "vite preview",
