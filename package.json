{
  "name": "bender",
  "private": true,
  "version": "1.16.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/demoreel.ts --missing && astro dev",
    "blog:draft": "node scripts/blogdraft.mjs",
    "build": "astro sync && tsc -b && node scripts/demogen.mjs --check && node scripts/demoreel.ts && astro build",
    "ab": "node scripts/ab.ts",
    "agent": "node scripts/agent.ts",
    "agent:eval": "node scripts/agent-eval.ts",
    "arrive": "node scripts/arrive.ts",
    "audible": "node scripts/audible.ts",
    "bench": "node scripts/bench.ts",
    "bend-ends": "node scripts/bend-ends.ts",
    "blocks": "node scripts/blocks.ts",
    "cold": "node scripts/cold.ts",
    "controls": "node scripts/controls.ts",
    "cpu": "node scripts/cpu.ts",
    "dash": "node scripts/dash.ts",
    "og": "node scripts/og.ts",
    "jam": "node scripts/jam.mjs",
    "demos": "node scripts/demogen.mjs",
    "reel": "node scripts/demoreel.ts",
    "diagram": "node scripts/chain-svg.ts",
    "features": "node scripts/features.ts",
    "guide-shots": "node scripts/guide-shots.ts",
    "diagram-shots": "node scripts/diagram-shots.ts",
    "ink": "node scripts/ink.ts",
    "knife": "node scripts/knife.ts",
    "panel": "node scripts/panel.ts",
    "soak": "node scripts/soak.ts",
    "toy": "node hardware/toy/build.ts",
    "toy:pcb": "node hardware/toy/pcb.ts",
    "spectrum": "node scripts/spectrum.ts",
    "preview": "astro preview",
    "test": "scripts/heavy-run-slot.sh vitest run",
    "test:full": "BENDER_FULL=1 scripts/heavy-run-slot.sh vitest run",
    "test:changed": "scripts/heavy-run-slot.sh vitest run --changed main --passWithNoTests",
    "check": "pnpm lint && pnpm typecheck && pnpm test:changed",
    "denormal": "DENORMAL=1 scripts/heavy-run-slot.sh vitest run src/dsp/denormal.test.ts",
    "typecheck": "astro sync && scripts/heavy-run-slot.sh tsc -b",
    "sync:check": "node scripts/sync-check.mjs",
    "pat": "node scripts/push.mjs patch",
    "min": "node scripts/push.mjs minor",
    "maj": "node scripts/push.mjs major",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "prepare": "husky",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "version": "git-cliff --tag v$npm_package_version -o CHANGELOG.md && git add CHANGELOG.md"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@floating-ui/react": "^0.27.20",
    "astro": "^7.4.2",
    "firebase": "13.1.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ],
    "*.astro": [
      "prettier --write"
    ]
  }
}
