{
  "name": "bender",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro sync && tsc -b && node scripts/demogen.mjs --check && tsx scripts/demoreel.ts && astro build",
    "ab": "tsx scripts/ab.ts",
    "agent": "tsx scripts/agent.ts",
    "agent:eval": "tsx scripts/agent-eval.ts",
    "arrive": "tsx scripts/arrive.ts",
    "audible": "tsx scripts/audible.ts",
    "bench": "tsx scripts/bench.ts",
    "blocks": "tsx scripts/blocks.ts",
    "cold": "tsx scripts/cold.ts",
    "dash": "tsx scripts/dash.ts",
    "demos": "node scripts/demogen.mjs",
    "reel": "tsx scripts/demoreel.ts",
    "diagram": "tsx scripts/chain-svg.ts",
    "features": "tsx scripts/features.ts",
    "figure": "tsx scripts/figure.ts",
    "guide-shots": "tsx scripts/guide-shots.ts",
    "ink": "tsx scripts/ink.ts",
    "knife": "tsx scripts/knife.ts",
    "panel": "tsx scripts/panel.ts",
    "soak": "tsx scripts/soak.ts",
    "spectrum": "tsx scripts/spectrum.ts",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro sync && tsc -b",
    "sync:check": "node scripts/sync-check.mjs",
    "pat": "node scripts/push.mjs patch",
    "min": "node scripts/push.mjs minor",
    "maj": "node scripts/push.mjs major",
    "format": "oxfmt && prettier --write \"src/**/*.astro\"",
    "prepare": "husky",
    "format:check": "oxfmt --check && prettier --check \"src/**/*.astro\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "version": "git-cliff --tag v$npm_package_version -o CHANGELOG.md && git add CHANGELOG.md"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@floating-ui/react": "^0.27.20",
    "astro": "^7.3.2",
    "firebase": "12.19.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier-plugin-astro": "^1.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ],
    "*.astro": [
      "prettier --write"
    ]
  }
}
