---
// The shell every site page shares: the head, the bar across the top, the
// footer, and the three stylesheets all of them want. A page supplies its own
// `<main>`, because each one wraps its content differently, and imports its own
// stylesheet on top of these.
//
// `/app/` does not use this. The instrument carries no bar and no footer, and
// its head says things no other page says.
import Analytics from '../components/Analytics.astro'
import Footer from '../components/Footer.astro'
import SiteBar from '../components/SiteBar.astro'
import { siteRoot } from '../site/paths'
// Every stylesheet the site has, here and in this order, because the order is
// the cascade and a page cannot be trusted to land after the shared sheets:
// Astro emits a layout's stylesheets *after* the importing page's, so a sheet
// imported by the page itself arrives first and loses. `.landing` and `.doc`
// both set `padding-block`, and `.wrap` in site.css sets `padding` — the
// shorthand, so it zeroes the block edges of anything it reaches later.
//
// The cost is that every page carries the other pages' rules, which is about a
// kilobyte gzipped. The alternative was each page overriding the shared sheets
// on specificity, which is a rule nobody can check by eye and which had already
// silently cost the landing page and the guide all their vertical padding.
import '../theme.css'
import '../site/site.css'
import '../site/footer.css'
import '../site/home.css'
import '../site/guide.css'

interface Props {
  title: string
  description: string
  /** Absolute URL of this page, for `<link rel="canonical">`. */
  canonical: string
  /** Set on a page that should stay out of search. */
  robots?: string
  /** Passed to the bar: `false` on a page that does not load the home script. */
  account?: boolean
  /** Passed to the bar, to mark the nav link for the page it is on. */
  current?: string
}
const {
  title,
  description,
  canonical,
  robots,
  account = true,
  current,
} = Astro.props
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    {/* `viewport-fit=cover` is what makes the `env(safe-area-inset-*)` padding
        in site.css and footer.css mean anything on a notched phone. */}
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href={`${siteRoot}favicon.svg`} />
    <title>{title}</title>
    {robots !== undefined && <meta name="robots" content={robots} />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e0e11" />
    <meta name="color-scheme" content="dark" />
    {/* How the link unfurls when shared, on a page anybody shares. */}
    <slot name="meta" />
    {/* Anything the page needs before analytics: its scripts, its own meta. */}
    <slot name="head" />
    <Analytics />
  </head>
  <body id="top">
    <SiteBar account={account} current={current} />
    <slot />
    <Footer />
  </body>
</html>
