---
import Analytics from '../../components/Analytics.astro'
import Bender from '../../Bender'
import { siteRoot } from '../../home/paths'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="ai-instructions"
      content="This page exposes window.bender, a scripting API for playing the instrument. Evaluate bender.help for the contract, then orient with bender.summary()."
    />
    <link rel="icon" type="image/svg+xml" href={`${siteRoot}favicon.svg`} />
    <title>bender</title>
    <Analytics />
  </head>
  <body>
    <div id="root">
      <Bender client:only="react" />
    </div>
  </body>
</html>
