---
import Analytics from '../../components/Analytics.astro'
import Bender from '../../Bender.tsx'
import { siteRoot } from '../../site/paths.ts'
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="ai-instructions"
      content="This page exposes window.bender, a scripting API for playing the instrument. Evaluate bender.help for the contract, then orient with bender.summary()."
    />
    <meta name="theme-color" content="#0e0e11" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href={`${siteRoot}favicon.svg`} />
    <title>bender</title>
    <style is:inline>
      body {
        margin: 0;
        background: #0e0e11;
      }
    </style>
    <Analytics />
  </head>
  <body>
    <div id="root">
      <Bender client:only="react" />
    </div>
  </body>
</html>
