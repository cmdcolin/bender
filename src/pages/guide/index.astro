---
import { getEntry, render } from 'astro:content'
import { guideUrl } from '../../site/paths.ts'
import Page from '../../layouts/Page.astro'
import { ORIGIN } from '../../site/site.ts'

const entry = await getEntry('docs', 'user-guide')
if (entry === undefined) throw new Error('docs/USER-GUIDE.md missing')
const { Content } = await render(entry)
---

<Page
  title="User guide — bender"
  description="How to play bender: the keyboard, the drum machine, the FM chip, presets and bends."
  canonical={`${ORIGIN}guide/`}
  account={false}
  current={guideUrl}
>
  <main class="wrap doc">
    <Content />
  </main>
</Page>
