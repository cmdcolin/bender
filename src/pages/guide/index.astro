---
import { getEntry, render } from 'astro:content'
import Analytics from '../../components/Analytics.astro'
import { appUrl, guideUrl, siteRoot } from '../../home/paths'
import '../../theme.css'
import '../../home/home.css'
import '../../home/guide.css'

const entry = await getEntry('docs', 'user-guide')
if (entry === undefined) throw new Error('docs/USER-GUIDE.md missing')
const { Content } = await render(entry)
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${siteRoot}favicon.svg`} />
    <title>User guide — bender</title>
    <meta
      name="description"
      content="How to play bender: the keyboard, the drum machine, the FM chip, presets and bends."
    />
    <Analytics />
  </head>
  <body>
    <header class="bar">
      <div class="barIn">
        <a class="brand" href={siteRoot}>
          bender
        </a>
        <nav class="barNav" aria-label="Site">
          <a href={guideUrl} aria-current="page">
            User guide
          </a>
          <a href="https://github.com/cmdcolin/bender">Source</a>
        </nav>
        <div class="barEnd">
          <a class="btn primary" href={appUrl}>
            Open the app →
          </a>
        </div>
      </div>
    </header>

    <main class="wrap prose doc">
      <Content />
    </main>
  </body>
</html>
