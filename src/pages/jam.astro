---
import Page from '../layouts/Page.astro'
import jams from '../jam/jams.json'
import { jamUrl } from '../site/paths.ts'
import { ORIGIN } from '../site/site.ts'

const AUDIO = 'https://myloveydove.com/jam-of-the-day/'
const EMAIL = 'colin.diesh@gmail.com'

const dateOf = (name: string) =>
  name
    .match(/(\d{4})(\d{2})(\d{2})/)
    ?.slice(1)
    .join('-')

const rows = jams
  .map(({ name, peaks }) => ({
    src: `${AUDIO}${name}.mp3`,
    title: dateOf(name) ?? name,
    order: dateOf(name) ?? '',
    peaks,
  }))
  .toSorted(
    (a, b) => b.order.localeCompare(a.order) || a.title.localeCompare(b.title),
  )
---

<Page
  title="Jam of the day — bender"
  description="A jam made in bender each day, and how to send in your own."
  canonical={`${ORIGIN}jam/`}
  account={false}
  current={jamUrl}
>
  <main class="wrap">
    <h1>Jam of the day</h1>
    <p>
      Send your own jam of the day to
      <a href={`mailto:${EMAIL}?subject=Jam%20of%20the%20day`}>{EMAIL}</a>.
    </p>
    <ul class="jamList">
      {rows.map(row => (
        <li class="jam" data-src={row.src}>
          <button
            class="jamPlay"
            type="button"
            aria-label={`Play ${row.title}`}
          >
            ▶
          </button>
          <div class="jamBody">
            <strong>{row.title}</strong>
            <div class="jamWave">
              {row.peaks.map(v => (
                <i style={`height:${Math.max(4, v)}%`} />
              ))}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </main>
</Page>

<style is:global>
  .jamList {
    padding: 0;
  }
  .jam {
    display: flex;
    gap: var(--space-lg);
    align-items: center;
    margin: var(--space-2xl) 0;
    list-style: none;
  }
  .jamBody {
    flex: 1;
    min-width: 0;
  }
  .jamPlay {
    flex: none;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    font-size: 18px;
    cursor: pointer;
  }
  .jamWave {
    display: flex;
    gap: 1px;
    align-items: center;
    height: 56px;
    cursor: pointer;
  }
  .jamWave i {
    flex: 1;
    border-radius: 1px;
    background: var(--border);
  }
  .jamWave i.done {
    background: var(--accent);
  }
</style>

<script>
  const audio = new Audio()
  const jams = [...document.querySelectorAll<HTMLElement>('.jam')]
  let current: HTMLElement | undefined

  const fill = (jam: HTMLElement, fraction: number) => {
    jam.querySelectorAll('.jamWave i').forEach((bar, i, bars) => {
      bar.classList.toggle('done', i < fraction * bars.length)
    })
  }

  const label = () => {
    for (const jam of jams) {
      jam.querySelector('.jamPlay')!.textContent =
        jam === current && !audio.paused ? '❚❚' : '▶'
    }
  }

  const select = (jam: HTMLElement) => {
    if (current === jam) return
    if (current) fill(current, 0)
    current = jam
    audio.src = jam.dataset.src!
  }

  for (const jam of jams) {
    jam.querySelector('.jamPlay')!.addEventListener('click', () => {
      select(jam)
      if (audio.paused) void audio.play()
      else audio.pause()
    })
    jam.querySelector('.jamWave')!.addEventListener('click', event => {
      const box = (event.currentTarget as HTMLElement).getBoundingClientRect()
      const fraction = ((event as MouseEvent).clientX - box.left) / box.width
      select(jam)
      const seek = () => {
        audio.currentTime = fraction * audio.duration
        void audio.play()
      }
      if (audio.readyState) seek()
      else audio.addEventListener('loadedmetadata', seek, { once: true })
    })
  }

  audio.addEventListener('timeupdate', () => {
    if (current) fill(current, audio.currentTime / audio.duration)
  })
  audio.addEventListener('play', label)
  audio.addEventListener('pause', label)
  audio.addEventListener('ended', () => {
    if (current) fill(current, 0)
    label()
  })
</script>
