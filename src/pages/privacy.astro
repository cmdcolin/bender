---
import Page from '../layouts/Page.astro'
import { ORIGIN } from '../site/site'

const NAME = 'bender'
const ANALYTICS_EXTRA = ''
---

<Page
  title="Privacy — bender"
  description="bender uses GoatCounter to count visits and Firebase to store your saved voices. Nothing else."
  canonical={`${ORIGIN}privacy/`}
  account={false}
>
  <main class="wrap privacy">
    <!-- CROSS_REPO_SYNC(privacy-analytics) -->
    <h1>Privacy</h1>
    <p class="privacyLead">
      We use Firebase for logins, and storing some of the settings you make
      there, and GoatCounter to count page views, without cookies, to see if
      anyone is actually using this. {ANALYTICS_EXTRA} That is all. Please
      contact colin.diesh@gmail.com for concerns.
    </p>
    <!-- CROSS_REPO_SYNC_END(privacy-analytics) -->
  </main>
</Page>
