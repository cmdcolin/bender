---
import Page from '../layouts/Page.astro'

const NAME = 'bender'
---

<Page
  title="Privacy — bender"
  description="bender uses Google Analytics to count visits and Firebase to store your saved voices. Nothing else."
  account={false}
>
  <main class="wrap privacy">
    <!-- CROSS_REPO_SYNC(privacy-analytics) -->
    <h1>Privacy</h1>
    <p class="privacyLead">
      {NAME} runs in your browser. Two outside services are involved, and this
      page is the whole list.
    </p>

    <h2>Google Analytics</h2>
    <p>
      Counts visits: which pages get opened, roughly where from, and on what
      sort of device. It loads only after you press OK on the notice in the
      corner of the page, and it sets cookies once it does. Everything here
      works the same without it.{' '}
      <button class="why" id="analyticsAgain" type="button">
        Change your answer
      </button>
    </p>
    <!-- CROSS_REPO_SYNC_END(privacy-analytics) -->

    <h2>Firebase</h2>
    <p>
      Only if you sign in. Google handles the sign-in, and one Firestore
      document holds your saved voices: a name, and the board it stands for,
      spelled the same way a shared link spells it. The same document holds the
      last eight boards you had open, so the home page can offer them back. Stay
      signed out and there is no document at all.
    </p>
  </main>
  <script>
    import { forgetAnalyticsAnswer } from '../analytics'

    // CROSS_REPO_SYNC(privacy-analytics-reset)
    // A reload, so the notice asks again on a page that has not loaded the tag.
    document.getElementById('analyticsAgain')?.addEventListener('click', () => {
      forgetAnalyticsAnswer()
      location.reload()
    })
    // CROSS_REPO_SYNC_END(privacy-analytics-reset)
  </script>
</Page>
