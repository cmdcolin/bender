---
import Page from '../layouts/Page.astro'
import { ORIGIN } from '../site/site'

const NAME = 'bender'
---

<Page
  title="Privacy — bender"
  description="bender uses Google Analytics to count visits and Firebase to store your saved voices. Nothing else."
  canonical={`${ORIGIN}privacy/`}
  account={false}
>
  <main class="wrap privacy">
    <!-- CROSS_REPO_SYNC(privacy-analytics) -->
    <h1>Privacy</h1>
    <p class="privacyLead">
      We use Firebase for logins, and storing some of the settings you make
      there, and Google Analytics to see if anyone is actually using this. That
      is all. Please contact colin.diesh@gmail.com for concerns.
    </p>
    <!-- CROSS_REPO_SYNC_END(privacy-analytics) -->
  </main>
  <script>
    import { forgetAnalyticsAnswer } from '../analytics'

    // CROSS_REPO_SYNC(privacy-analytics-reset)
    // A reload, so the notice asks again on a page that has not loaded the tag.
    document.getElementById('analyticsAgain')?.addEventListener('click', () => {
      forgetAnalyticsAnswer()
      location.reload()
    })
    // CROSS_REPO_SYNC_END(privacy-analytics-reset)
  </script>
</Page>
