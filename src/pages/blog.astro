---
import { getCollection } from 'astro:content'

import Page from '../layouts/Page.astro'
import { blogUrl, siteRoot } from '../site/paths.ts'
import { isoDay, longDate, newestFirst, published } from 'skillet-shared/posts'
import { imageSize } from '../site/imageSize.ts'
import { ORIGIN } from '../site/site.ts'

const NAME = 'bender'
const changelogHref =
  'https://github.com/cmdcolin/bender/blob/main/CHANGELOG.md'
const postHref = (id: string) => `${blogUrl}${id}/`
const assetHref = (path: string) => `${siteRoot}${path.replace(/^\//, '')}`
const posts = newestFirst(await getCollection('posts', published))
const imageSizes = await Promise.all(
  posts.map(post => imageSize(post.data.image)),
)
---

<Page
  title="Blog — bender"
  description="New instruments and bends in bender, and how they work."
  canonical={`${ORIGIN}blog/`}
  account={false}
  current={blogUrl}
>
  <main class="wrap blog">
    <!-- CROSS_REPO_SYNC(blog-index) -->
    <h1>Blog</h1>
    <p class="blogLead">
      Each post shows something new in {NAME} and explains how it works. The{' '}
      <a href={changelogHref}>changelog</a> lists every change.
    </p>
    {posts.length === 0 && <p>There are no posts yet.</p>}
    {posts.map((post, i) => (
      <article class="postCard" id={post.id}>
        <a class="postCardImage" href={postHref(post.id)} tabindex="-1">
          <img
            src={assetHref(post.data.image)}
            alt={post.data.imageAlt}
            {...imageSizes[i]}
            loading="lazy"
          />
        </a>
        <div>
          <h2>
            <a href={postHref(post.id)}>{post.data.title}</a>
          </h2>
          <p class="postMeta">
            <time datetime={isoDay(post.data.date)}>
              {longDate(post.data.date)}
            </time>
          </p>
          <p>{post.data.summary}</p>
        </div>
      </article>
    ))}
    <!-- CROSS_REPO_SYNC_END(blog-index) -->
  </main>
</Page>
