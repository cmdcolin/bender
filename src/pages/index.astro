---
import BoardRedirect from '../components/BoardRedirect.astro'
import Hero from '../components/Hero.astro'
import HomeSkeleton from '../components/HomeSkeleton.astro'
import Showcase from '../components/Showcase.astro'
import SignedInHint from 'skillet-shared/components/SignedInHint.astro'
import SocialMeta from 'skillet-shared/components/SocialMeta.astro'
import WhySignInCard from '../components/WhySignInCard.astro'
import Page from '../layouts/Page.astro'
import { SHARE_SHOT } from '../site/shareShot.ts'
import { SIGNED_IN_HINT } from '../ui/cloud.ts'
import { ORIGIN } from '../site/site.ts'

const TITLE = 'bender — a circuit bender in the browser'
const DESCRIPTION =
  'A toy keyboard, a drum machine and an FM chip, bent in the browser. Every board is a link.'

const SHARE_IMAGE = `${ORIGIN}${SHARE_SHOT.file}`
---

<Page title={TITLE} description={DESCRIPTION} canonical={ORIGIN}>
  <Fragment slot="meta">
    <SocialMeta
      siteName="bender"
      url={ORIGIN}
      title={TITLE}
      description={DESCRIPTION}
      image={SHARE_IMAGE}
      imageWidth={SHARE_SHOT.width}
      imageHeight={SHARE_SHOT.height}
    />
  </Fragment>

  <Fragment slot="head">
    <BoardRedirect />
    <SignedInHint hint={SIGNED_IN_HINT} />
    <script>
      import '../home/main.ts'
      import '../home/listen.ts'
    </script>
  </Fragment>

  <HomeSkeleton />

  <main class="wrap wide landing" id="landing">
    <Hero />
    <Showcase />
  </main>

  {/* Where main.ts draws the home, for a reader who is signed in. */}
  <div id="home" class="home" hidden></div>

  <WhySignInCard />
</Page>
