---
import Analytics from '../components/Analytics.astro'
import Card from '../components/Card.astro'
import { DEFAULT_CONTROLS } from '../controls'
import { appUrl, privacyUrl, siteRoot } from '../home/paths'
import { applyPreset } from '../ui/presets/apply'
import { PRESETS } from '../ui/presets/table'
import { SIGNED_IN_HINT } from '../ui/cloud'
import { boardHash } from '../ui/share'
import { FREE_WITHOUT, PITCH } from '../ui/whySignIn'
import '../theme.css'
import '../home/home.css'

// Spelled by the app's own writer, so a card stays right when its preset changes.
const presets = PRESETS.map(preset => ({
  query: boardHash('', applyPreset(preset, { ...DEFAULT_CONTROLS })),
  name: preset.name,
  says: preset.blurb,
}))
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${siteRoot}favicon.svg`} />
    <title>bender — a circuit bender in the browser</title>
    <meta
      name="description"
      content="A toy keyboard, a drum machine and an FM chip, bent in the browser. Every board is a link."
    />
    <!-- Every board bender has ever shared is a link to this page carrying a
         hash, and for a while some carried `?set=` instead. The app moved to
         /app/, so this runs before anything else on the page loads and hands
         the board straight on rather than opening a homepage over it. -->
    <script is:inline define:vars={{ appUrl }}>
      if (
        location.hash !== '' ||
        new URLSearchParams(location.search).has('set')
      )
        location.replace(appUrl + location.search + location.hash)
    </script>
    <!-- Runs before the first paint. A browser that has signed in before
         gets the skeleton in place of the landing page, so the home does not
         replace a landing page the reader has already started reading.
         main.ts clears the flag once Firebase answers; the timeout is for a
         Firebase that never does. -->
    <script is:inline define:vars={{ SIGNED_IN_HINT }}>
      try {
        if (localStorage.getItem(SIGNED_IN_HINT) === '1') {
          const root = document.documentElement
          root.dataset.home = 'pending'
          setTimeout(() => {
            delete root.dataset.home
          }, 5000)
        }
      } catch {}
    </script>
    <script>
      import '../home/main'
    </script>
    <Analytics />
  </head>
  <body>
    <header class="bar">
      <div class="barIn">
        <a class="brand" href={siteRoot}>bender</a>
        <nav class="barNav" aria-label="Site">
          <a
            href="https://github.com/cmdcolin/bender/blob/main/docs/USER-GUIDE.md"
            >User guide</a
          >
          <a href="https://github.com/cmdcolin/bender">Source</a>
          <a href={privacyUrl}>Privacy</a>
        </nav>
        <div class="barEnd">
          <!-- Beside the sign-in button, where the reader meets the ask. -->
          <button class="why" id="why" type="button">Why sign in?</button>
          <button class="btn" id="signIn" type="button">
            <svg
              class="ico"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="3.6"></circle>
              <path d="M4.8 20a7.2 7.2 0 0 1 14.4 0"></path>
            </svg>
            Sign in
          </button>
          <div class="acct" id="acct" hidden>
            <button
              class="acctBtn"
              id="acctBtn"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
            >
              <span class="avatar" id="avatar"></span>
            </button>
            <div class="acctMenu" id="acctMenu" role="menu" hidden>
              <p class="acctName" id="acctName"></p>
              <button
                class="acctOut"
                id="signOut"
                type="button"
                role="menuitem"
              >
                Sign out
              </button>
            </div>
          </div>
          <a class="btn primary" href={appUrl}>Open the app →</a>
        </div>
      </div>
    </header>

    <div class="homeWait" aria-hidden="true">
      <div class="homeIn">
        <div class="rail">
          <span class="bone railBone"></span>
          <span class="bone railBone"></span>
          <span class="bone railBone"></span>
        </div>
        <div class="homeMain">
          <span class="bone headBone"></span>
          <ul class="grid">
            <li><span class="bone cardBone"></span></li>
            <li><span class="bone cardBone"></span></li>
            <li><span class="bone cardBone"></span></li>
            <li><span class="bone cardBone"></span></li>
            <li><span class="bone cardBone"></span></li>
            <li><span class="bone cardBone"></span></li>
          </ul>
        </div>
      </div>
    </div>

    <main class="wrap" id="landing">
      <h1 class="head">Simulated circuit bending</h1>
      <p class="pitch">
        A toy keyboard, a drum machine and a small FM chip, wired up in the
        browser: starve the supply until the chip
        reboots, solder a bend spot, bridge the trigger pins, and run the whole
        thing through tape delay, reverb and distortion. You work it from the
        signal path diagram rather than a wall of sliders, and every board it
        makes is a link you can send.
      </p>
      <figure class="figure">
        <img
          src={`${siteRoot}panel-callout.jpg`}
          width="1600"
          height="900"
          alt="The panel drawn large on the left and the whole app small beside it, with the panel ringed in red where it sits down the right-hand side of the window: the toy board and its shared supply at the top, the chaos oscillator, noise and sampler feeding the mix bus, the bend slots beside the pedals and the tape machine, and the feedback bus running back under the whole run"
        />
      </figure>
      <p class="cta">
        <a class="btn primary big" href={appUrl}>Open the app →</a>
        <a
          class="btn big"
          href="https://github.com/cmdcolin/bender/blob/main/docs/GETTING-STARTED.md"
          >Getting started</a
        >
      </p>
      <p class="dim">
        Sign in to keep voices under a name and pick a session up on another
        machine. Everything else works signed out.{' '}
        <button class="why" id="whyBelow" type="button">Why sign in?</button>
      </p>
      <section class="sec" id="presets">
        <h2 class="secHead">Presets</h2>
        <p class="secSub">Open one and the board arrives set up that way.</p>
        <ul class="grid">
          {presets.map(p => <Card {...p} />)}
        </ul>
      </section>
    </main>

    <div id="home" hidden></div>

    <!-- The long answer, from the same strings the app's own card renders, so
         the two say the same thing. Built here at build time, so it is in the
         page for a reader with no JavaScript. -->
    <dialog class="whyCard" id="whyCard" aria-labelledby="whyHead">
      <div class="whyTop">
        <h2 class="whyHead" id="whyHead">Why sign in?</h2>
        <button class="btn" id="whyClose" type="button">Close</button>
      </div>
      <p class="whyPitch">{PITCH}</p>
      <p class="whyLine">
        {FREE_WITHOUT} <a href={privacyUrl}>What an account holds →</a>
      </p>
      <p class="cta">
        <button class="btn primary" id="whySignIn" type="button"
          >Sign in with Google</button
        >
        <a class="btn" href={appUrl}>Open the app instead →</a>
      </p>
    </dialog>
  </body>
</html>
