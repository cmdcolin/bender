---
import BoardRedirect from '../components/BoardRedirect.astro'
import Hero from '../components/Hero.astro'
import HomeSkeleton from '../components/HomeSkeleton.astro'
import Showcase from '../components/Showcase.astro'
import SignedInHint from '../components/SignedInHint.astro'
import WhySignInCard from '../components/WhySignInCard.astro'
import Page from '../layouts/Page.astro'
import '../home/home.css'
---

<Page
  title="bender — a circuit bender in the browser"
  description="A toy keyboard, a drum machine and an FM chip, bent in the browser. Every board is a link."
>
  <Fragment slot="head">
    <BoardRedirect />
    <SignedInHint />
    <script>
      import '../home/main'
      import '../home/listen'
    </script>
  </Fragment>

  <HomeSkeleton />

  <main class="wrap wide landing" id="landing">
    <Hero />
    <Showcase />
  </main>

  {/* Where main.ts draws the home, for a reader who is signed in. */}
  <div id="home" class="home" hidden></div>

  <WhySignInCard />
</Page>
