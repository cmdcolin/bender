---
// Four close-ups of the panel under the hero picture, each a link into the app.
import { appUrl, siteRoot } from '../site/paths'

const SHOTS = [
  {
    file: 'guide-keyboard.jpg',
    width: 1100,
    height: 298,
    wide: true,
    alt: 'The toy keyboard: three octaves of keys under the REC, HOLD and octave switches',
  },
  {
    file: 'guide-drums.jpg',
    width: 556,
    height: 312,
    wide: false,
    alt: 'The toy drum machine: eight rubber pads, kick through cymbal',
  },
  {
    file: 'guide-trigger.jpg',
    width: 942,
    height: 634,
    wide: false,
    alt: 'The trigger patch: the drums, the keyboard and the FM chip as three boxes with wires between them',
  },
  {
    file: 'guide-fm.jpg',
    width: 1100,
    height: 261,
    wide: true,
    alt: 'The FM chip keybed: a green circuit board with rows of push-button keys',
  },
]
---

<ul class="gallery">
  {SHOTS.map(shot => (
    <li class:list={['shot', { wide: shot.wide }]}>
      <a href={appUrl}>
        <img
          src={`${siteRoot}gallery/${shot.file}`}
          width={shot.width}
          height={shot.height}
          alt={shot.alt}
          loading="lazy"
        />
      </a>
    </li>
  ))}
</ul>
