---
import { boardUrl } from '../home/paths'
import Mark from './Mark.astro'

interface Props {
  query: string
  name: string
  says: string
}
const { query, name, says } = Astro.props
---

<li>
  <a class="card" href={boardUrl(query)}>
    <span class="cardTop"><Mark query={query} /><span class="open">open →</span></span>
    <span class="cardName">{name}</span>
    <span class="says">{says}</span>
  </a>
</li>
