---
// What a returning reader sees while Firebase answers: the shape of the home,
// in place of a landing page they would only watch be replaced. SignedInHint
// puts it up before the first paint and main.ts takes it down.
---

<div class="homeWait" role="status">
  <span class="vh">Loading your voices</span>
  <div class="homeIn" aria-hidden="true">
    <div class="rail">
      <span class="bone railBone"></span>
      <span class="bone railBone"></span>
      <span class="bone railBone"></span>
    </div>
    <div class="homeMain">
      <span class="bone headBone"></span>
      <ul class="grid">
        {Array.from({ length: 6 }, () => (
          <li>
            <span class="bone cardBone"></span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>
