---
import { appUrl, pocketUrl } from '../site/paths.ts'
import { pile } from '../site/pile.ts'

const GETTING_STARTED =
  'https://github.com/cmdcolin/bender/blob/main/docs/GETTING-STARTED.md'
---

<h1 class="heroHead">Simulated circuit bending</h1>
<figure class="pile" set:html={pile()} />
<script>
  import { noiseTile } from '../site/grain.ts'
  import { pile } from '../site/pile.ts'

  const figure = document.querySelector<HTMLElement>('.pile')
  if (figure) {
    figure.innerHTML = pile(Math.floor(Math.random() * 2 ** 31))
    const grain = noiseTile()
    if (grain) figure.style.setProperty('--grain', `url(${grain})`)
    figure.dataset.ready = ''
  }
</script>
<p class="cta">
  <a class="btn primary big" href={appUrl}>
    Open the app →
  </a>
  <a class="btn big" href={pocketUrl}>
    Simple version
  </a>
  <a class="btn big" href={GETTING_STARTED}>
    Getting started
  </a>
</p>
