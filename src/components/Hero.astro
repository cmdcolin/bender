---
// The top of the landing page: a headline, a picture of the panel, and the
// ways in.
import { appUrl, pocketUrl, siteRoot } from '../site/paths'
import { PANEL_SHOT } from '../site/site'

const GETTING_STARTED =
  'https://github.com/cmdcolin/bender/blob/main/docs/GETTING-STARTED.md'
---

<h1 class="heroHead">Simulated circuit bending</h1>
<figure class="figure">
  <img
    src={`${siteRoot}${PANEL_SHOT.file}`}
    width={PANEL_SHOT.width}
    height={PANEL_SHOT.height}
    alt="The panel drawn large on the left and the whole app small beside it, with the panel ringed in red where it sits down the right-hand side of the window: the toy board and its shared supply at the top, the chaos oscillator, noise and sampler feeding the mix bus, the bend slots beside the pedals and the tape machine, and the feedback bus running back under the whole run"
  />
</figure>
<p class="cta">
  <a class="btn primary big" href={appUrl}>
    Open the app →
  </a>
  <a class="btn big" href={pocketUrl}>
    On a phone
  </a>
  <a class="btn big" href={GETTING_STARTED}>
    Getting started
  </a>
</p>
