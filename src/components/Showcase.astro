---
import { jams } from '../jam/jams.ts'
import { jamUrl } from '../site/paths.ts'
---

<section id="demos" aria-labelledby="listenHead">
  <h2 class="head" id="listenHead">
    Demos
  </h2>
  <p>
    From the <a href={jamUrl}>jam of the day</a>, recorded in bender.
  </p>
  <ul class="tracks">
    {jams.map(jam => (
      <li class="track">
        <a class="play" href={jam.src} aria-label={`Play ${jam.title}`}>
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path class="iPlay" d="M4 2.5v11l9.5-5.5z" />
            <path class="iPause" d="M3.5 2.5h3.2v11H3.5zM9.3 2.5h3.2v11H9.3z" />
          </svg>
        </a>
        <span class="trackText">
          <span class="cardName">{jam.title}</span>
          <span class="bar">
            <span class="fill" />
          </span>
        </span>
      </li>
    ))}
  </ul>
</section>
